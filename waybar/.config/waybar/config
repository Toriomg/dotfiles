{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "modules-left": [
    "custom/notification",
    "hyprland/workspaces",
    "custom/pacman",
    "custom/claudebar",
    "tray"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "group/expand",
    "group/tools",
    "group/misc",
    "group/power"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": true,
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5,
        6
      ]
    }
  },
  "group/misc": {
    "orientation": "horizontal",
    "modules": [
      "privacy",
      "network",
      "bluetooth",
      "pulseaudio",
      "pulseaudio#microphone",
      "backlight"
    ]
  },
  "privacy": {
    "icon-spacing": 6,
    "icon-size": 14,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare"
      },
      {
        "type": "audio-in"
      },
      {
        "type": "audio-out"
      }
    ]
  },
  "group/expand": {
    "orientation": "horizontal",
    "modules": [
      "custom/expand-icon",
      "temperature",
      "cpu",
      "memory",
      "custom/gpu-nvidia",
      "disk"
    ],
    "drawer": {
      "transition-duration": 500,
      "children-class": "not-first",
      "transition-left-to-right": true
    }
  },
  "group/power": {
    "orientation": "horizontal",
    "modules": [
      "custom/power-status",
      "custom/power-performance",
      "custom/power-balanced",
      "custom/power-saver"
    ],
    "drawer": {
      "transition-duration": 300,
      "children-class": "power-option",
      "transition-left-to-right": false
    }
  },
  "group/tools": {
    "orientation": "horizontal",
    "modules": [
      "custom/colorpicker",
      "custom/screenshot",
      "hyprland/language"
    ]
  },
  "custom/power-performance": {
    "format": " ",
    "on-click": "powerprofilesctl set performance",
    "tooltip": true,
    "tooltip-format": "Performance"
  },
  "custom/power-balanced": {
    "format": " ",
    "on-click": "powerprofilesctl set balanced",
    "tooltip": true,
    "tooltip-format": "Balanced"
  },
  "custom/power-saver": {
    "format": " ",
    "on-click": "powerprofilesctl set power-saver",
    "tooltip": true,
    "tooltip-format": "Power Saver"
  },
  "custom/colorpicker": {
    "format": " ",
    "on-click": "hyprpicker -a",
    "tooltip": true,
    "tooltip-format": "Seleccionar color"
  },
  "custom/notification": {
    "tooltip": false,
    "format": "",
    "on-click": "swaync-client -t -sw",
    "escape": true
  },
  "custom/expand-icon": {
    "format": "",
    "tooltip": false
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %d %B, %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6666'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "network": {
    "format-wifi": " ",
    "format-ethernet": "󰤭 ",
    "format-disconnected": "󰤫 ",
    "tooltip-format": "Red: {ifname}\nIP: {ipaddr}\nEstado: {essid} ({signalStrength}%)",
    "tooltip-format-wifi": "󰤨  {essid}\n󰗊  {frequency} MHz\n󰐈  {signalStrength}%\n󰇚  {bandwidthDownBits}\n󰇓  {bandwidthUpBits}\nIP {ipaddr}",
    "tooltip-format-ethernet": "󰈀  {ifname}\n󰇚  {bandwidthDownBits}\n󰇓  {bandwidthUpBits}",
    "tooltip-format-disconnected": "󰤮  Desconectado",
    "on-click": "kitty nmtui"
  },
  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\n{status}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": " {device_alias}",
    "tooltip-format-enumerate-connected-battery": " {device_alias} ({device_battery_percentage}%)",
    "on-click-right": "rfkill toggle bluetooth",
    "on-click": "blueman-manager"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "󰂰",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": "",
      "hands-free": "󰂰",
      "headset": "󰂰",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip-format": "Volumen: {volume}%\n{desc}"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "",
    "format-source-muted": "",
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "on-click-right": "pavucontrol",
    "scroll-step": 5,
    "tooltip-format": "Micrófono: {source_desc}\nVolumen: {source_volume}%",
    "format-icons": {
      "headphone": "",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    }
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} ",
    "format-icons": [
      "󰃞",
      "󰃝",
      "󰃟",
      "󰃠"
    ],
    "tooltip-format": "Brillo: {percent}%",
    "on-scroll-up": "brightnessctl set 10%+",
    "on-scroll-down": "brightnessctl set 10%-"
  },
  "custom/pacman": {
    "format": "󰅢  {}",
    "interval": 300,
    "exec": "checkupdates | wc -l",
    "on-click": "kitty sh -c 'sudo pacman -Syu; echo Done - Press enter; read'"
  },
  "cpu": {
    "format": "  {usage}%",
    "interval": 2
  },
  "memory": {
    "format": "  {percentage}%",
    "interval": 5
  },
  "temperature": {
    "thermal-zone": 5,
    "critical-threshold": 75,
    "format-critical": "{icon}{temperatureC}°C!",
    "format": "{icon}{temperatureC}°C",
    "format-icons": [
      "",
      "",
      ""
    ],
    "interval": 2
  },
  "tray": {
    "icon-size": 15,
    "spacing": 10
  },
  "hyprland/language": {
    "format": "󰌌  {}",
    "format-en": "US",
    "format-es": "ES",
    "keyboard-name": "at-translated-set-2-keyboard",
    "on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next"
  },
  "custom/gpu-nvidia": {
    "format": "{}",
    "interval": 3,
    "exec": "~/.config/waybar/scripts/gpu-nvidia.sh",
    "tooltip": true,
    "tooltip-format": "GPU NVIDIA\nUso: {essid}%",
    "on-click": "kitty --hold nvidia-smi",
    "on-click-right": "kitty nvtop"
  },
  "disk": {
    "interval": 30,
    "format": "󰋊 {percentage_used}%",
    "path": "/",
    "tooltip": true,
    "tooltip-format": "Disco: {path}\nUsado: {used} de {total}\nLibre: {free}"
  },
  "mpris": {
    "format": "⏸ {title}",
    "format-paused": "▶ {title}",
    "format-stopped": "",
    "max-length": 10,
    "ellipsis": "…",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": true,
    "tooltip-format": "{player}\n{artist} — {title}"
  },
  "custom/screenshot": {
    "format": " ",
    "on-click": "hyprshot -m region",
    "on-click-right": "hyprshot -m output",
    "tooltip": true,
    "tooltip-format": "Click izq: Captura región\nClick der: Captura pantalla completa"
  },
  "custom/claudebar": {
    "exec": "claudebar --icon \"<span font='Font Awesome 7 Brands'>&#xe861;</span>\" --format '{session_pct}%'",
    "return-type": "json",
    "interval": 300,
    "signal": 13,
    "tooltip": true,
    "on-click": "xdg-open https://claude.ai/settings/usage"
  },
  "custom/power-status": {
    "exec": "~/.config/waybar/scripts/power-status.sh",
    "return-type": "json",
    "interval": 10,
    "signal": 8,
    "tooltip": true
  }
}
