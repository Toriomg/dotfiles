{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "modules-left": [
    "custom/notification",
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "custom/pacman",
    "group/expand",
    "group/connectivity",
    "group/audio",
    "group/power",
    "hyprland/language"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5,
        6
      ]
    }
  },
  "group/connectivity": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "bluetooth"
    ]
  },
  "group/audio": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio"
    ]
  },
  "group/expand": {
    "orientation": "horizontal",
    "modules": [
      "temperature",
      "cpu",
      "memory",
      "custom/gpu-nvidia"
    ]
  },
  "group/power": {
    "orientation": "horizontal",
    "modules": [
      "backlight",
      "battery",
      "group/power-profiles"
    ]
  },
  "group/power-profiles": {
    "orientation": "horizontal",
    "modules": [
      "custom/power-saver",
      "custom/balanced",
      "custom/performance"
    ]
  },
  "hyprland/window": {
    "format": "{}",
    "separate-outputs": true,
    "max-length": 35
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "default": " ",
      "performance": " ",
      "balanced": " ",
      "power-saver": " "
    }
  },
  "custom/colorpicker": {
    "format": "",
    "on-click": "hyprpicker -a",
    "tooltip": true,
    "tooltip-format": "Seleccionar color"
  },
  "custom/notification": {
    "tooltip": false,
    "format": "",
    "on-click": "swaync-client -t -sw",
    "escape": true
  },
  "clock": {
    "format": "{:%a %d - %H:%M}",
    "interval": 60,
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "network": {
    "format-wifi": " ",
    "format-ethernet": "󰤭 ",
    "format-disconnected": "󰤫 ",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "on-click": "kitty nmtui"
  },
  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "on-click-right": "blueman-manager"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": "󰂰  {volume}%",
    "format-muted": "󰝟  Mut",
    "format-icons": {
      "headphone": "",
      "hands-free": "󰂰",
      "headset": "󰂰",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip-format": "{icon} {desc} | {volume}%"
  },
  "battery": {
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}  {percent}%",
    "format-icons": [
      "󰃞",
      "󰃝",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-up": "brightnessctl set 10%+",
    "on-scroll-down": "brightnessctl set 10%-"
  },
  "custom/pacman": {
    "format": "󰅢  {}",
    "interval": 300,
    "exec": "checkupdates | wc -l",
    "on-click": "kitty sh -c 'sudo pacman -Syu; echo Done - Press enter; read'"
  },
  "cpu": {
    "format": "  {usage}%",
    "interval": 2
  },
  "memory": {
    "format": "  {percentage}%",
    "interval": 5
  },
  "temperature": {
    "thermal-zone": 5,
    "critical-threshold": 75,
    "format-critical": "{icon}{temperatureC}°C!",
    "format": "{icon}{temperatureC}°C",
    "format-icons": [
      "",
      "",
      ""
    ],
    "interval": 2
  },
  "tray": {
    "icon-size": 15,
    "spacing": 10
  },
  "hyprland/language": {
    "format": "󰌌  {}",
    "format-en": "US",
    "format-es": "ES",
    "keyboard-name": "at-translated-set-2-keyboard",
    "on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next"
  },
  "custom/gpu-nvidia": {
    "format": "{}",
    "interval": 3,
    "exec": "~/.config/waybar/scripts/gpu-nvidia.sh",
    "tooltip": true,
    "tooltip-format": "GPU NVIDIA\nUso: {essid}%",
    "on-click": "kitty --hold nvidia-smi",
    "on-click-right": "kitty nvtop"
  },
  "custom/power-saver": {
    "format": "",
    "on-click": "powerprofilesctl set power-saver"
  },
  "custom/balanced": {
    "format": "",
    "on-click": "powerprofilesctl set balanced"
  },
  "custom/performance": {
    "format": "",
    "on-click": "powerprofilesctl set performance"
  }
}