[manager]
ratio          = [ 1, 3, 4 ] # Proporción de las 3 columnas
sort_by        = "alphabetical"
sort_sensitive = false
sort_reverse   = false
sort_dir_first = true
show_hidden    = false
show_symlink   = true

[preview]
tab_size        = 4
max_width       = 600
max_height      = 900
cache_dir       = ""
image_filter    = "triangle"
image_quality   = 75
sixel_fraction  = 0.15

[opener]
edit = [
    { exec = '${EDITOR:-nvim} "$@"', block = true, desc = "Editor" },
]
play = [
    { exec = 'mpv "$@"', orphan = true, desc = "Reproducir" },
]

[open]
rules = [
	{ name = "*.pdf", use = "play" }, # Para ver tus enunciados de PL
	{ name = "*.l",   use = "edit" }, # Tus archivos de Flex
	{ name = "*.y",   use = "edit" }, # Tus archivos de Bison
]
