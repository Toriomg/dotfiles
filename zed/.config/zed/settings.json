// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto"
      },
      "type": "registry"
    }
  },
  "agent_ui_font_size": 16.0,
  "disable_ai": false,
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 1.0
  },
  "window_decorations": "client",
  "use_system_window_tabs": false,
  "window_title_separator": " - ",
  "window_title_format": "${projectName${separator}${fileName}",
  "focus_follows_mouse": {
    "enabled": true
  },
  "centered_layout": {
    "right_padding": 0.2,
    "left_padding": 0.0
  },
  "bottom_dock_layout": "contained",
  "tabs": {
    "show_close_button": "always",
    "file_icons": true,
    "close_position": "right",
    "git_status": false
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": false,
    "show": true
  },
  "search": {
    "button": true
  },
  "diagnostics": {
    "button": true
  },
  "terminal": {
    "button": true
  },
  "vim": {
    "cursor_shape": {
      "insert": "bar",
      "normal": "block"
    },
    "toggle_relative_line_numbers": true
  },
  "preferred_line_length": 140,
  "toolbar": {
    "code_actions": false
  },
  "minimap": {
    "thumb": "always",
    "max_width_columns": 60,
    "show": "always"
  },
  "scrollbar": {
    "show": "auto"
  },
  "relative_line_numbers": "disabled",
  "edit_predictions": {
    "provider": "ollama"
  },
  "icon_theme": "Base Charmed Icons",
  "selection_highlight": true,
  "rounded_selection": false,
  "hide_mouse": "on_typing_and_action",
  "cursor_shape": "bar",
  "cursor_blink": true,
  "ui_font_family": ".ZedSans",
  "git": {
    "hunk_style": "staged_hollow",
    "blame": {
      "show_avatar": true
    },
    "inline_blame": {
      "show_commit_summary": true,
      "min_column": 0,
      "padding": 18,
      "enabled": true
    },
    "gutter_debounce": 0,
    "disable_git": false
  },
  "agent": {
    "button": false,
    "dock": "right",
    "sidebar_side": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "show_count_badge": false,
    "scrollbar": {
      "show": "auto"
    },
    "file_icons": true,
    "collapse_untracked_diff": false,
    "sort_by_path": false,
    "fallback_branch_name": "main",
    "default_width": 360.0,
    "status_style": "label_color",
    "dock": "left",
    "tree_view": false
  },
  "project_panel": {
    "button": true,
    "sort_order": "default",
    "sort_mode": "directories_first",
    "indent_guides": {
      "show": "always"
    },
    "diagnostic_badges": true,
    "show_diagnostics": "all",
    "scrollbar": {
      "show": "auto"
    },
    "bold_folder_labels": false,
    "folder_indicator": "chevron",
    "git_status": true,
    "file_icons": true,
    "hide_gitignore": false,
    "default_width": 180.0,
    "indent_size": 20.0,
    "dock": "right"
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_menus": false,
    "show_user_picture": false,
    "show_user_menu": true,
    "show_sign_in": true,
    "show_onboarding_banner": true,
    "show_worktree_name": false,
    "show_branch_name": true,
    "show_branch_status_icon": true
  },
  "status_bar": {
    "pending_keystrokes_indicator": true,
    "cursor_position_button": false,
    "show_active_file": false,
    "line_endings_button": false,
  },
  "buffer_font_weight": 500.0,
  "buffer_line_height": "standard",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "base_keymap": "VSCode",
  "ui_font_size": 18.0,
  "buffer_font_size": 16.0,
  "theme": "VSCode Dark Polished",
}
